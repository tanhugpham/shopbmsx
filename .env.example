# Shop Xoài Non Customer API v1
# Giữ API key ở máy chủ. Không đưa vào Git, nhật ký, Google Sheets hoặc Google Docs.
SHOP_XOAI_NON_BASE_URL=https://shopxoainon.online/api/v1
SHOP_XOAI_NON_API_KEY=

# File Google có sẵn, đã chia sẻ quyền Sửa cho email service account.
# Phase 4.3B: CHỈ một spreadsheet cho catalog, nguồn, MENU và báo giá.
# Không dùng NASTELE_SPREADSHEET_ID hoặc LAST_SPREADSHEET_ID. Hai biến đó bị bỏ qua.
GOOGLE_SPREADSHEET_ID=196goR1lDZN6zJfoC3a7vOVyo5u9o-pvxXpc3mnGrGSY
GOOGLE_DOCUMENT_ID=
# Tương đối với thư mục gốc dự án, không phụ thuộc thư mục đang mở của terminal.
# Có thể thay bằng đường dẫn tuyệt đối.
GOOGLE_CREDENTIALS_FILE=./GOOGLE_CREDENTIALS_FILE.json

APP_ENV=development
DRY_RUN=true
ENABLE_PURCHASE=false
ENABLE_TELEGRAM=false
# Phase 4.3F: không bật scheduler và không cho scheduler ghi Google.
ENABLE_SCHEDULED_SYNC=false
ENABLE_SCHEDULED_MENU_LIVE=false
SCHEDULED_SYNC_SECONDS=300

# Thời gian chờ mỗi request HTTP, tính bằng giây.
REQUEST_TIMEOUT_SECONDS=30

# Nastele Partner API. Chỉ đọc sản phẩm. Không đưa key vào Git.
NASTELE_BASE_URL=https://nastele.online
NASTELE_API_KEY=
# Khi hai nguồn cùng giá, chọn nhà cung cấp này. shop_xoai_non hoặc nastele.
PREFERRED_SUPPLIER_ID=shop_xoai_non
# Số lượng dùng để so giá. Mặc định 1 nên không lấy giá sỉ mua từ 10 hoặc 25.
COMPARISON_QUANTITY=1
# Trần tài liệu là 60 request mỗi phút cho mỗi key.
NASTELE_RATE_LIMIT_PER_MINUTE=60

# Tùy chọn: so layout MENU với baseline đã chụp trước khi ghi.
# Để trống thì mỗi lượt sync chỉ dùng cấu trúc MENU đọc live.
# Đổi layout có chủ ý thì chụp baseline mới bằng `menu-baseline`.
# MENU_BASELINE_FILE=./backups/menu-baseline-phase43b.json
